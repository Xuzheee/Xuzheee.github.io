---
import '../styles/mori.css';
import '../styles/mori-reading.css';
import '../styles/mori-navigation.css';
import SiteFooter from '../components/mori/SiteFooter.astro';
import Arrow from '../components/mori/Arrow.astro';
import NavigationHead from '../components/mori/NavigationHead.astro';
const { title = 'Mori · 杨黄旭哲', active = 'home', pageClass = '', description = '喜欢游戏、音乐、电影，也喜欢和 AI 伙伴一起动手做点东西。这里是 Mori 的个人网站。' } = Astro.props;
const navigation = [{id:'home',href:'/',name:'Home'},{id:'about',href:'/about/',name:'About'},{id:'projects',href:'/projects/',name:'Work'},{id:'interests',href:'/interests/',name:'Interests'}];
const activeIndex = Math.max(0, navigation.findIndex(item => item.id === active));
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <NavigationHead />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F6F4EE" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/mori-chinese.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/anton.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={new URL(Astro.url.pathname, 'https://xuzheee.github.io')} />
  </head>
  <body class:list={['mori-site', { 'm-home-site': pageClass === 'm-home' }]}>
    <a class="m-skip" href="#main">跳到正文</a>
    <header class="m-header" id="top">
      <a class="m-logo" href="/" aria-label="Mori 首页" lang="en"><img class="m-logo-mark" src="/mori/mori-mark-b.webp" alt="" width="40" height="40" />Mori</a>
      <nav aria-label="Main navigation" lang="en" data-mori-nav style={`--nav-index:${activeIndex}`}>
        <span class="m-nav-pill" aria-hidden="true"></span>
        {navigation.map(item => <a href={item.href} aria-current={active === item.id ? 'page' : undefined} data-highlighted={active === item.id ? 'true' : undefined}>{item.name}</a>)}
      </nav>
      <a class="m-header-contact" href="#contact" lang="en">Let’s talk <Arrow direction="diagonal" /></a>
    </header>
    <main id="main" class={pageClass} tabindex="-1"><slot /></main>
    <SiteFooter />
    <div class="m-toast" role="status" aria-live="polite"></div>
    <script>import '../scripts/mori';</script>
    <script>import '../scripts/header-navigation';</script>
    <script>import '../scripts/navigation';</script>
  </body>
</html>
