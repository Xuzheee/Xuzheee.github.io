---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import ProjectResults from "../components/ProjectResults.astro";
import { profile, experiences, getProject, skills } from "../data/portfolio";
const cvProjects = ["inky-app", "inky-paper", "cookie-cats", "steam-analytics"].map(getProject);
---

<BaseLayout title={`CV | ${profile.name}`} description={profile.description} sideBarActiveItemID="cv">
  <section class="reveal mb-12">
    <div class="flex flex-col gap-8 md:flex-row md:items-start">
      <div class="flex-1">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-base-content/60">Curriculum Vitae</p>
        <h1 class="mt-3 text-4xl font-bold">{profile.name}</h1>
        <p class="mt-4 text-lg leading-relaxed text-base-content/80">
          {profile.introduction}
        </p>
        <p class="mt-4 text-lg leading-relaxed text-base-content/80">
          {profile.background}
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="btn btn-primary" href={profile.resume} download>下载 Resume PDF</a>
          <a class="btn btn-outline" href={`mailto:${profile.email}`}>联系我</a>
          <a class="btn btn-ghost" href={profile.github} target="_blank">GitHub</a>
        </div>
      </div>

      <div class="w-32 flex-shrink-0 md:w-40">
        <div class="glow-card aspect-[3/4] w-full overflow-hidden rounded-lg border border-base-300 shadow-lg">
          <img src="/avatar.jpg" alt="杨黄旭哲" class="h-full w-full object-cover" />
        </div>
      </div>
    </div>

    <p class="mt-6 text-sm text-base-content/65">履历与下载简历同步于 <time datetime={profile.resumeSyncedAt}>{profile.resumeSyncedAt}</time>；Inky Paper 的近期进展另见案例。</p>

    <ul class="mt-8 grid gap-3 text-base md:grid-cols-2">
      <li><span class="font-semibold">邮箱：</span>{profile.email}</li>
      <li><span class="font-semibold">电话：</span>{profile.phone}</li>
      <li><span class="font-semibold">个人网页：</span>{profile.website}</li>
      <li><span class="font-semibold">英语：</span>CET-6 / IELTS 6.5</li>
    </ul>
  </section>

  <section class="reveal reveal-delay-1 mb-12">
    <div class="mb-5">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-base-content/60">Education</p>
      <h2 class="mt-2 text-3xl font-bold">教育背景</h2>
    </div>

    <div class="time-line-container grid gap-4">
      <TimeLineElement
        title="计算社会科学硕士"
        subtitle="2025.09 - 2027.06（预计）| 香港中文大学（深圳）"
      >
        相关课程：统计建模、机器学习、数据挖掘、文本分析、回归分析、高级统计学。
      </TimeLineElement>
      <TimeLineElement
        title="社会学 法学学士"
        subtitle="2021.09 - 2025.07 | 中国农业大学"
      >
        主修课程：社会科学统计分析、定量研究方法、社会政策理论。曾担任校新闻中心记者，并获优秀学生记者奖项。
      </TimeLineElement>
    </div>
  </section>

  <section class="reveal reveal-delay-2 mb-12">
    <div class="mb-5">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-base-content/60">Experience</p>
      <h2 class="mt-2 text-3xl font-bold">实习与研究经历</h2>
    </div>

    <div class="time-line-container grid gap-4">
      {experiences.map((item) => (
        <div>
          <TimeLineElement title={item.title} subtitle={[item.project.period, item.organization].filter(Boolean).join(" | ")}>
            {item.project.description} {item.project.id === "urai-lab" && item.project.result + "。"}
            {item.project.hasCase && <a class="ml-2 text-primary underline underline-offset-4" href={`/projects/${item.project.id}/`}>阅读案例</a>}
          </TimeLineElement>
          {item.project.id === "netease-ai-workflow" && <div class="pl-9"><ProjectResults projectId={item.project.id} /></div>}
        </div>
      ))}
    </div>
  </section>

  <section class="reveal reveal-delay-2 mb-12">
    <div class="mb-5">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-base-content/60">Selected Projects</p>
      <h2 class="mt-2 text-3xl font-bold">代表项目</h2>
    </div>

    <div class="grid gap-4">
      {cvProjects.map((project) => (
        <div class="glow-card rounded-lg border border-base-300 p-5">
          <h3 class="font-bold">{project.title}</h3>
          <p class="mt-2 leading-relaxed text-base-content/80">{project.description}</p>
          <p class="mt-2 text-sm text-base-content/75">{project.result}</p>
          {project.hasCase && <a class="mt-3 inline-block text-primary underline underline-offset-4" href={`/projects/${project.id}/`}>阅读案例</a>}
        </div>
      ))}
    </div>
  </section>

  <section class="reveal reveal-delay-3 mb-6">
    <div class="mb-5">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-base-content/60">Skills</p>
      <h2 class="mt-2 text-3xl font-bold">技能</h2>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      {skills.map((skill) => (
        <div class="glow-card rounded-lg border border-base-300 p-5">
          <h3 class="font-bold">{skill.title}</h3>
          <p class="mt-2 text-sm leading-relaxed">{skill.description}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
