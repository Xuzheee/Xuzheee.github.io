---
import MoriLayout from '../layouts/MoriLayout.astro';
import FeaturedCards from '../components/mori/FeaturedCards.astro';
import ProjectArchive from '../components/mori/ProjectArchive.astro';
---
<MoriLayout title="作品 · Mori" active="projects">
 <section class="m-featured m-scene m-featured-card-section" aria-labelledby="works-title" id="featured">
  <aside class="m-works-index"><h1 class="m-display" id="works-title">作品</h1><p>运营判断、数据分析与<br />AI 评测。</p><nav aria-label="作品目录" data-section-nav><a class="is-current" href="#featured" aria-current="location">重点案例</a><a href="#tools">工具与实验</a><a href="#research">更多经历</a></nav></aside>
  <div class="m-featured-rows"><FeaturedCards /></div>
 </section>
 <ProjectArchive />
</MoriLayout>

<style>
  .m-featured-card-section { padding-bottom: 64px; }
  .m-featured-rows { min-width: 0; }
  @media (min-width: 901px) {
    .m-featured-card-section { display: grid; grid-template-columns: 19% 81%; }
    .m-works-index { position: sticky; top: 30px; display: block; align-self: start; margin-bottom: 0; }
    .m-works-index > p { margin-top: 22px; }
    .m-works-index nav { margin-top: 34px; margin-left: 0; font-size: 16px; }
    .m-featured-rows { padding-left: 34px; }
  }
  @media (max-width: 900px) {
    .m-featured-card-section { display: block; }
    .m-works-index { position: static; margin-bottom: 36px; }
    .m-featured-rows { padding-left: 0; }
  }
</style>
