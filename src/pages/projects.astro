---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { categories, projects, profile } from "../data/portfolio";
---

<BaseLayout title={`Projects | ${profile.name}`} description="AI 工作流、桌面产品、数据分析与社会科学研究项目，包含个人职责、成果和重点案例。" sideBarActiveItemID="projects">
  <section class="reveal mb-10">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-base-content/60">Projects</p>
    <h1 class="mt-3 text-4xl font-bold leading-tight">项目作品集</h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-base-content/80">
      这里整理了我在 AI 工作流、数据分析、社会计算与 Human-AI Interaction 方向的实践。重点案例说明问题、职责、关键取舍与验证过程，其余项目保留简要介绍和成果入口。
    </p>
    <div class="mt-6 flex flex-wrap gap-2">
      {categories.map((category) => <a class="btn btn-outline btn-sm" href={`#${category.id}`}>{category.label}</a>)}
    </div>
  </section>

  {categories.map((category, categoryIndex) => (
    <section id={category.id} class:list={["reveal mb-12 scroll-mt-8", `reveal-delay-${Math.min(categoryIndex + 1, 3)}`]}>
      <div class="mb-5">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-base-content/60">{category.subtitle}</p>
        <h2 class="mt-2 text-3xl font-bold">{category.title}</h2>
      </div>
      {projects.filter((project) => project.category === category.id).map((project, index) => (
        <>
          {index > 0 && <div class="divider my-0"></div>}
          <ProjectCard project={project} />
        </>
      ))}
    </section>
  ))}
</BaseLayout>
