---
import Arrow from './Arrow.astro';
import ProjectArtwork from './ProjectArtwork.astro';
import HomeSkills from './HomeSkills.astro';
import Town from './Town.astro';
import { albums, games } from '../../data/mori';
---
<section class="m-hub m-scene" id="explore" aria-labelledby="hub-title">
  <header class="m-hub-heading"><h2 class="m-display" id="hub-title">从这里出发</h2><p class="m-subtitle">点一栋建筑，去下一站。</p></header>
  <Town />
</section>
<section class="m-home-work m-scene" id="selected-work" aria-labelledby="home-work-title">
  <header class="m-home-work-heading">
    <h2 class="m-display" id="home-work-title">作品与探索</h2>
    <p class="m-subtitle">实际运营、独立开发和个人实验。</p>
  </header>
  <div class="m-home-work-main" data-project-id="inky-paper">
    <a class="m-desk" href="/projects/inky-paper/" aria-label="查看 Inky Paper 案例"><ProjectArtwork projectId="inky-paper" /><span class="m-view-bubble">查看</span></a>
    <div class="m-project-caption"><div><h3>Inky Paper</h3><p>把任务规划、专注执行和复盘放进同一套工作流程。</p></div><div class="m-project-caption-link"><p>独立设计与开发</p><a class="m-link" href="/projects/inky-paper/">查看案例 <Arrow /></a></div></div>
  </div>
  <div class="m-home-work-side">
    <article data-project-id="netease-ai-workflow"><a href="/projects/netease-ai-workflow/" aria-label="查看网易项目"><ProjectArtwork projectId="netease-ai-workflow" /></a><h3>网易</h3><h4>游戏用户分层与 AI 辅助触达</h4><p>连接用户理解、策略生成、客服执行与效果反馈。</p></article>
    <article data-project-id="seven-angry-man"><a href="/projects/#seven-angry-man" aria-label="探索多智能体陪审团"><ProjectArtwork projectId="seven-angry-man" /></a><h3>多智能体陪审团</h3><h4>一次关于讨论的实验</h4><p>观察 AI 如何回应证据、讨论与改变立场。</p><a class="m-link m-jury-link" href="https://seven-angry-agent-f6vjdwtdxgluau6qkvfmxv.streamlit.app/" target="_blank" rel="noopener noreferrer">探索原型 <Arrow /></a></article>
  </div>
  <a class="m-link m-all-work" href="/projects/">查看全部作品 <Arrow /></a>
</section>
<HomeSkills />
<section class="m-favorites m-scene" aria-labelledby="favorites-title">
  <div class="m-section-top"><h2 class="m-display" id="favorites-title">最近喜欢</h2><span>游戏与音乐</span></div>
  <div class="m-favorites-grid"><div class="m-favorite-music"><h3>最近在听</h3><div class="m-sleeves" data-sleeves>
    {albums.map((album,i)=><a class:list={['m-sleeve',{'is-selected':i===0}]} href={`/interests/?album=${album.id}#music`} data-sleeve={i} aria-label={`在兴趣页查看 ${album.title}`}><img class="m-sleeve-vinyl" src="/mori/vinyl.png" alt="" loading="lazy" /><img class="m-sleeve-cover" src={album.image} alt={`${album.title} 专辑封面`} loading="lazy" /><strong>{album.title}</strong><span class="m-sleeve-artist">{album.artist}</span></a>)}
  </div></div><div class="m-favorite-games"><h3>喜欢的游戏</h3>{games.map(game=><a href={`/interests/?game=${game.id}#games`}><img src={game.image} alt="" width="104" height="72" loading="lazy" /><span><strong>{game.title}</strong><small>{game.genre}</small></span><Arrow direction="diagonal" /></a>)}</div></div>
  <div class="m-favorites-bottom"><span>R&amp;B / Jazz / Hip-Hop</span><a href="/interests/">去兴趣页逛逛 <span class="m-circle"><Arrow /></span></a></div>
</section>
<section class="m-offscreen m-scene" aria-labelledby="offscreen-title">
  <div class="m-offscreen-left"><h2 class="m-display" id="offscreen-title">屏幕<br />之外</h2><p class="m-subtitle">屏幕之外，我喜欢打篮球、去徒步。</p><div class="m-offscreen-pair"><a href="/interests/#life"><figure><img src="/hobbies/sport1.jpg" alt="夜晚球场上的篮球队员" loading="lazy" /><figcaption>篮球</figcaption></figure></a><a href="/interests/#life"><figure><img src="/hobbies/hike4.jpg" alt="云雾笼罩的山林与湖水" loading="lazy" /><figcaption>山间</figcaption></figure></a></div><a class="m-link" href="/interests/#life">更多屏幕之外的记录 <Arrow /></a></div>
  <a class="m-offscreen-coast" href="/interests/#life"><figure><img src="/hobbies/hike3.jpg" alt="海边的金色岩壁" loading="lazy" /><figcaption>徒步</figcaption></figure></a>
</section>
