---
import Arrow from './Arrow.astro';
import Icon from '../Icon.astro';
import { profile } from '../../data/portfolio';
import '../../styles/mori-footer.css';
---
  <footer class="m-site-closing" id="contact" aria-labelledby="closing-title">
    <div class="m-closing-intro">
      <h2 id="closing-title" lang="en"><span>Nice to</span><span>meet you.</span></h2>
      <p>关于游戏、AI，或一个值得一起动手的想法。</p>
    </div>
    <div class="m-closing-contact">
      <p class="m-closing-label"><Icon name="mail" class="m-closing-icon" strokeWidth={1.6} />写封邮件给我</p>
      <a class="m-closing-email" href={`mailto:${profile.email}`}><span>{profile.email}</span><span class="m-closing-email-arrow"><Arrow direction="diagonal" /></span></a>
      <div class="m-closing-resume"><a href={profile.resume} download="杨黄旭哲_简历.pdf"><Icon name="fileText" class="m-closing-icon" strokeWidth={1.6} />下载简历 <Arrow direction="down" /></a><small>PDF · 更新于 {profile.resumeSyncedAt.replaceAll('-', '.')}</small></div>
      <a class="m-closing-github" href={profile.github} target="_blank" rel="noopener noreferrer"><Icon name="github" class="m-closing-icon" strokeWidth={1.6} />GitHub / Xuzheee <Arrow direction="diagonal" /></a>
      <div class="m-closing-bottom"><button type="button" data-closing-copy={profile.email}><Icon name="copy" class="m-closing-icon" strokeWidth={1.6} />复制邮箱</button><a href="#top">回到顶部 <Icon name="arrowUpToLine" class="m-closing-icon" strokeWidth={1.6} /></a></div>
    </div>
    <svg class="m-closing-color-filter" aria-hidden="true" width="0" height="0"><defs>
      <filter id="mori-footer-colors" color-interpolation-filters="sRGB">
        <feColorMatrix type="matrix" values="3 -3 0 0 0  3 -3 0 0 0  3 -3 0 0 0  0 0 0 1 0" />
        <feComponentTransfer>
          <feFuncR type="discrete" tableValues="0.160784 0.909804" />
          <feFuncG type="discrete" tableValues="0.156863 0.274510" />
          <feFuncB type="discrete" tableValues="0.145098 0.196078" />
        </feComponentTransfer>
      </filter>
    </defs></svg>
    <img class="m-closing-wordmark" src="/mori/mori-wordmark-footer.png" alt="Mori" width="2004" height="785" loading="lazy" />
    <span class="m-closing-status" role="status" aria-live="polite"></span>
  </footer>

<script>
  document.addEventListener('click', async (event) => {
    const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-closing-copy]') : null;
    if (!button?.dataset.closingCopy) return;
    const status = button.closest('footer')?.querySelector<HTMLElement>('.m-closing-status');
    if (!status) return;
    try { await navigator.clipboard.writeText(button.dataset.closingCopy); status.textContent = '邮箱已复制'; }
    catch { status.textContent = '复制未成功，请选中邮箱文字复制'; }
  });
</script>
