---
const skills = [
  { name: "Python", icon: "/skills/python.svg" },
  { name: "Pandas", icon: "/skills/pandas.svg" },
  { name: "NumPy", icon: "/skills/numpy.svg" },
  { name: "Scikit-learn", icon: "/skills/scikit-learn.svg" },
  { name: "FastAPI", icon: "/skills/fastapi.svg" },
  { name: "Selenium", icon: "/skills/selenium.svg" },
  { name: "React", icon: "/skills/react.svg" },
  { name: "Unity", icon: "/skills/unity.svg" },
  { name: "Figma", icon: "/skills/figma.svg" },
  { name: "MySQL", icon: "/skills/mysql.svg" },
  { name: "Git", icon: "/skills/git.svg" },
];

const marqueeItems = [...skills, ...skills];
---

<div class="skill-marquee" aria-label="技能滚动展示">
  <div class="skill-marquee__header">
    <span class="skill-marquee__line"></span>
    <span class="skill-marquee__pill">✦ Skills</span>
    <span class="skill-marquee__line"></span>
  </div>

  <div class="skill-marquee__viewport">
    <div class="skill-marquee__track">
      {
        marqueeItems.map((skill) => (
          <div class="skill-marquee__card">
            <img class="skill-marquee__icon" src={skill.icon} alt={`${skill.name} icon`} loading="lazy" />
            <span class="skill-marquee__name">{skill.name}</span>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .skill-marquee {
    margin: 1.5rem 0 1.75rem;
    overflow: hidden;
    border-radius: 0.5rem;
    background: transparent;
    padding: 1.75rem 0 1.5rem;
    color: #18181b;
  }

  .skill-marquee__header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
    padding: 0 2rem;
  }

  .skill-marquee__line {
    height: 1px;
    width: min(10rem, 28vw);
    background: linear-gradient(90deg, transparent, #d4d4d8, transparent);
  }

  .skill-marquee__pill {
    border-radius: 0.375rem;
    border: 1px solid #d4d4d8;
    background: #f4f4f5;
    padding: 0.65rem 1.25rem;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0;
    color: #27272a;
  }

  .skill-marquee__viewport {
    position: relative;
    overflow: hidden;
  }

  .skill-marquee__viewport::before,
  .skill-marquee__viewport::after {
    content: "";
    position: absolute;
    top: 0;
    z-index: 2;
    height: 100%;
    width: 5rem;
    pointer-events: none;
  }

  .skill-marquee__viewport::before {
    left: 0;
    background: linear-gradient(90deg, #ffffff, rgba(255, 255, 255, 0));
  }

  .skill-marquee__viewport::after {
    right: 0;
    background: linear-gradient(270deg, #ffffff, rgba(255, 255, 255, 0));
  }

  .skill-marquee__track {
    display: flex;
    width: max-content;
    gap: 1.5rem;
    animation: skill-scroll 28s linear infinite;
  }

  .skill-marquee:hover .skill-marquee__track {
    animation-play-state: paused;
  }

  .skill-marquee__card {
    display: flex;
    min-height: 8.25rem;
    width: 9.5rem;
    flex: 0 0 auto;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    border-radius: 0.5rem;
    border: 1px solid #d4d4d8;
    background: #ffffff;
    box-shadow: 0 8px 22px rgba(15, 23, 42, 0.06);
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .skill-marquee__card:hover {
    border-color: rgba(99, 102, 241, 0.42);
    box-shadow: 0 12px 30px rgba(99, 102, 241, 0.12);
    transform: translateY(-2px);
  }

  .skill-marquee__icon {
    height: 3.1rem;
    width: 3.1rem;
    object-fit: contain;
    transition: transform 180ms ease;
  }

  .skill-marquee__card:hover .skill-marquee__icon {
    transform: scale(1.08);
  }

  .skill-marquee__name {
    max-width: 8rem;
    text-align: center;
    color: #52525b;
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.25;
    transition: color 180ms ease;
  }

  .skill-marquee__card:hover .skill-marquee__name {
    color: #4f46e5;
  }

  @keyframes skill-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 0.75rem));
    }
  }

  @media (max-width: 640px) {
    .skill-marquee {
      margin-inline: -0.25rem;
      padding-top: 1.25rem;
    }

    .skill-marquee__header {
      margin-bottom: 1.5rem;
    }

    .skill-marquee__card {
      min-height: 7.25rem;
      width: 8rem;
    }

    .skill-marquee__track {
      gap: 1rem;
      animation-duration: 30s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-marquee__track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
      padding: 0 1rem;
    }
  }
</style>
