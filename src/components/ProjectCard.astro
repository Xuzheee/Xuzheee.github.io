---
import HorizontalCard from "./HorizontalCard.astro";
import { projectUrl, type Project } from "../data/portfolio";
interface Props { project: Project }
const { project } = Astro.props;
---
<HorizontalCard
  id={project.id}
  title={project.title}
  img={project.img}
  desc={project.description}
  url={projectUrl(project)}
  badge={project.badge}
  role={project.role}
  stack={project.stack}
  result={project.result}
  cta={project.hasCase ? "阅读案例" : project.links?.[0]?.label}
>
  {project.miniProgram && (
    <div class="mt-4 border-t border-base-300 pt-4 text-sm">
      <p class="font-semibold">在微信中体验</p>
      <p class="mt-1 text-base-content/70">复制下方小程序口令，在微信中打开；也可在微信搜索“集钉”。</p>
      <code class="mt-2 block select-all break-all rounded bg-base-200 p-3">{project.miniProgram.token}</code>
      <p class="mt-3 text-base-content/70">{project.miniProgram.registration}</p>
      <a class="link mt-1 inline-block" href={project.miniProgram.certificate} target="_blank" rel="noopener noreferrer">查看软件著作权登记证书（PDF）</a>
      <details class="mt-4">
        <summary class="cursor-pointer font-semibold">查看小程序界面</summary>
        <div class="mt-3 grid grid-cols-1 gap-5 sm:grid-cols-2">
          {project.miniProgram.screenshots.map((screenshot) => (
            <figure class="min-w-0">
              <img src={screenshot.src} alt={screenshot.caption} width="1206" height="2622" loading="lazy" class="mx-auto w-full max-w-[280px] rounded-lg border border-base-300" />
              <figcaption class="mt-2 text-center text-xs leading-relaxed text-base-content/70">{screenshot.caption}</figcaption>
            </figure>
          ))}
        </div>
      </details>
    </div>
  )}
</HorizontalCard>
