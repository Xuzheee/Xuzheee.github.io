---
const { active } = Astro.props;
const current = active ?? Astro.url.pathname.split('/').filter(Boolean)[0] ?? 'home';
const links = [
  { id: 'projects', label: '作品', href: '/projects' },
  { id: 'cv', label: '简历', href: '/cv' },
  { id: 'blog', label: '文章', href: '/blog/' },
  { id: 'interests', label: '生活', href: '/interests' },
];
---
<header class="site-header">
  <a href="/" class="wordmark" aria-label="Xuzheee 首页" aria-current={current === 'home' ? 'page' : undefined}>Xuzheee<span aria-hidden="true">.</span></a>
  <nav aria-label="主导航">
    {links.map(link => <a href={link.href} aria-current={current === link.id ? 'page' : undefined}>{link.label}</a>)}
  </nav>
  <a class="header-contact" href="#contact">联系我</a>
</header>
